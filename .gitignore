.venv/
__pycache__/
*.pyc
# trained memory + metadata are runtime state, regenerated on each run
models/
outputs/
# Downloaded source exports may be large or contain municipal-restricted data.
data/raw/
data/*.tif
# Geti training tiles: Esri imagery, regenerable from the committed manifest
# (scripts/geti_export_tiles.py --seed). manifest.csv and LABELING.md stay.
data/geti_tiles/*.png
data/geti_holdout/*.png
# Windows shortcut junk
*.lnk
# local agent/dev config — may contain secrets and machine-specific paths
.claude/

# Internal submission-prep documents — strategy notes, not project code.
submission/
# Superseded build artefacts and stale duplicates.
*.zip
temp_script.js
